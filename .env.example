# DrawPro Environment Variables
# Copy to .env.local and fill in your values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth Providers (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NVIDIA NIM API (for AI generation)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Vercel (auto-set on deploy)
# VERCEL_URL=your-vercel-url

# App
NEXT_PUBLIC_APP_URL=https://drawpro-omega.vercel.app
NEXT_PUBLIC_APP_NAME=DrawPro